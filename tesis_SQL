-- ============================================================
--  6. Cooling Events Log (relay / turbine history)
-- ============================================================

CREATE TABLE cooling_events (
    id           SERIAL PRIMARY KEY,
    process_id   INTEGER NOT NULL,
    ts           TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    action       TEXT NOT NULL CHECK (action IN ('ON','OFF','ALARM')),
    ambient_c    REAL,
    product_c    REAL,
    device_id    TEXT,
    source       TEXT DEFAULT 'auto' CHECK (source IN ('auto','manual')),
    FOREIGN KEY (process_id) REFERENCES cooking_process(id_process) ON DELETE CASCADE
);

CREATE INDEX idx_cooling_events_process_ts ON cooling_events(process_id, ts);

-- ============================================================
--  7. Ovens (Hornos físicos)
-- ============================================================

CREATE TABLE ovens (
    id_oven        SERIAL PRIMARY KEY,
    name           VARCHAR(100) NOT NULL,
    location       TEXT,
    description    TEXT,
    is_active      BOOLEAN DEFAULT TRUE,
    created_at     TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_ovens_active ON ovens(is_active);



-- ============================================================
--  8. Devices (Dispositivos IoT)
-- ============================================================

CREATE TABLE devices (
    id_device      SERIAL PRIMARY KEY,
    device_uid     VARCHAR(100) NOT NULL UNIQUE,
    device_type    TEXT NOT NULL CHECK (device_type IN ('esp32','raspberry','jetson','other')),
    model          TEXT,
    firmware_ver   TEXT,
    notes          TEXT,
    is_active      BOOLEAN DEFAULT TRUE,
    last_seen      TIMESTAMP,
    created_at     TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_devices_uid ON devices(device_uid);



-- ============================================================
--  9. Device ↔ Oven Mapping (Escalable y flexible)
-- ============================================================

CREATE TABLE oven_device_mapping (
    id              SERIAL PRIMARY KEY,
    oven_id         INTEGER NOT NULL,
    device_id       INTEGER NOT NULL,
    assigned_at     TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    unassigned_at   TIMESTAMP,
    is_active       BOOLEAN DEFAULT TRUE,
    FOREIGN KEY (oven_id) REFERENCES ovens(id_oven),
    FOREIGN KEY (device_id) REFERENCES devices(id_device)
);

CREATE INDEX idx_oven_device_active
ON oven_device_mapping(oven_id, device_id, is_active);



-- ============================================================
--  10. Device Activity Log (opcional – valor tesis)
-- ============================================================

CREATE TABLE device_activity_log (
    id           SERIAL PRIMARY KEY,
    device_id    INTEGER NOT NULL,
    ts           TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    event_type   TEXT NOT NULL CHECK (event_type IN ('CONNECTED','DISCONNECTED','ERROR','DATA_SENT')),
    description  TEXT,
    FOREIGN KEY (device_id) REFERENCES devices(id_device)
);

CREATE INDEX idx_device_activity_ts ON device_activity_log(device_id, ts);



